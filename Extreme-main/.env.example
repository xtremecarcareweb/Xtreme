# Environment Variables Template
# Copy this file to .env.local and fill in the actual values

# Google Apps Script API URL - Your deployed Apps Script web app endpoint
VITE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Admin authentication token for protected operations (create bookings, delete, etc)
# IMPORTANT: Change this in production and store securely
# Use a strong, randomly generated token
VITE_ADMIN_AUTH_TOKEN=your_secure_token_here
