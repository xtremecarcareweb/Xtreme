# Environment Variables Template
# Copy this file to .env (or .env.local) and fill in the real values.
# Never commit the filled-in file. On Vercel, set these under Project Settings -> Environment Variables.
# Every VITE_ variable is read at BUILD time and embedded in the public JavaScript bundle,
# so never put a secret (password, token, API key) in a VITE_ variable.

# REQUIRED. URL of the deployed Google Apps Script web app (Deploy -> Manage deployments -> Web app URL).
# Every request (catalog, slots, bookings, cancellation, admin) goes to this one endpoint.
# The app refuses to start if this is missing.
VITE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# OPTIONAL. Sentry DSN for frontend error reporting (Sentry -> Project Settings -> Client Keys).
# Leave empty to disable Sentry.
VITE_SENTRY_DSN=

# ADMIN_PASSWORD is NOT a frontend variable and must not be added here.
# It is set directly in apps-script/Code.gs (const ADMIN_PASSWORD = "...") and never leaves the server.
# The admin types it on /admin; the backend checks it and returns a short-lived session token.
# While Code.gs still has the placeholder value, every login attempt is rejected.
